{
  "name": "socratic-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview:local": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "miniflare": "4.20260730.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "4.157.0"
  }
}
